# ============================================================
#   System Toolbox - configurazione
#
#   Per usarlo: rinomina questo file in  toolbox.conf
#   e mettilo accanto a toolbox.command.
#
#   Il file NON viene eseguito: viene letto riga per riga e
#   vengono accettate solo le chiavi elencate qui sotto. Una
#   chiave sconosciuta viene ignorata in silenzio.
#
#   La riga di comando ha sempre la precedenza su questo file.
# ============================================================

# --- soglie degli avvisi ---------------------------------

# Percentuale di riempimento del disco oltre la quale compare
# un avviso, e quella oltre la quale diventa una criticita'.
disco_avviso=80
disco_critico=90

# Percentuale di memoria in uso oltre la quale avvisare.
# Non usato su macOS: il sistema usa tutta la RAM disponibile come
# cache, quindi la percentuale in uso e' sempre alta e non dice
# niente. L'indicatore che conta e' lo swap (swap_avviso_mb).
ram_critica=90

# Megabyte di swap in uso oltre i quali segnalare che la
# memoria non basta per il carico attuale.
# Su macOS e' l'indicatore piu' importante: la RAM libera non
# significa nulla, perche' il sistema usa tutta la memoria
# disponibile come cache.
swap_avviso_mb=1024

# Numero di elementi di avvio automatico oltre il quale
# segnalare che incidono sul tempo di accensione.
avvii_avviso=12

# Giorni di accensione continuata oltre i quali suggerire un
# riavvio.
uptime_avviso_giorni=7

# --- preferenze ------------------------------------------

# Quanti file di log conservare nella cartella logs/.
log_da_conservare=15

# Colori: auto | si | no | daltonici
#   auto       colori solo se l'output e' un terminale
#   no         nessun colore, utile per redirigere su file
#   daltonici  blu e arancione al posto di verde e rosso, e
#              ogni stato porta comunque un simbolo
colori=auto

# Lingua dei messaggi. Non usato al momento: esiste solo
# l'italiano, e la chiave e' riservata per una traduzione futura.
lingua=it

# Cornici e barre: ascii | utf8
#   ascii  # . = -   leggibile ovunque, anche via SSH e in
#          console di ripristino. E' il predefinito.
#   utf8   blocchi pieni e tratti continui: piu' bello nel
#          Terminale di macOS, che e' sempre in UTF-8.
cornici=ascii

# Simboli di stato: ascii | emoji
#   ascii  [ok] [!] [X]   e' il predefinito
#   emoji  piu' immediato nel Terminale di macOS, illeggibile
#          via SSH con LANG=C o in una console di ripristino.
#          Il livello di rischio resta scritto a parole accanto
#          al pallino: il colore da solo non basta.
simboli=ascii

# --- analisi ---------------------------------------------

# Interrogare softwareupdate durante l'analisi completa.
# E' la sezione piu' lenta: richiede la rete e puo' impiegare
# un minuto e mezzo. Mettila a no se non ti interessa.
analisi_aggiornamenti=si

# Per quante ore riutilizzare il risultato di softwareupdate
# prima di richiederlo. Due analisi ravvicinate non hanno
# motivo di ripetere la stessa attesa.
cache_aggiornamenti_ore=6

# Tempo massimo, in secondi, per misurare la dimensione di una
# singola cartella. du deve attraversare tutto l'albero: su un
# backup di iPhone da decine di GB, e a maggior ragione su un
# disco meccanico, puo' durare minuti. Alla scadenza il valore
# viene mostrato come "oltre X GB", cioe' dichiarato parziale
# invece di essere sbagliato.
misura_max_secondi=12

# --- interfaccia -----------------------------------------

# Chiedere conferma con una finestra di dialogo, invece che
# con [s/N] nel terminale, per le operazioni che non sono
# marcate [sicuro]. A un "[s/N]" in fondo a una schermata di
# testo si risponde per abitudine; una finestra si nota.
conferme_grafiche=no

# Notifica di sistema al termine di una serie di operazioni.
# Utile quando la pulizia e' lunga e nel frattempo si va a
# fare altro.
notifica_fine=si

# Barra di avanzamento durante le operazioni lunghe.
# Non usato su macOS: la barra esiste solo per gli aggiornamenti
# dei pacchetti su Linux. La chiave c'e' perche' la configurazione
# resti la stessa sui sistemi.
avanzamento=si

# Ridimensionare la finestra del Terminale all'avvio.
# Disattivato di default: se lanci il tool da una sessione
# gia' aperta, vedersela ridimensionare sotto le mani da'
# fastidio.
ridimensiona_terminale=no
